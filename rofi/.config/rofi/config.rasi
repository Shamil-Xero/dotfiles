/**
 * Main Rofi Configuration
 **/

configuration {
    modi:                       "drun,run,filebrowser,window";
    font:                       "JetBrainsMono Nerd Font 10";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    display-drun:               "   Apps ";
    display-run:                "   Run ";
    display-filebrowser:        "   Files ";
    display-window:             "   Windows ";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    sidebar-mode:               false;e
    hover-select:               true;
    me-select-entry:            "MousePrimary";s
    me-accept-entry:            "MouseDPrimary";
    cycle:                      false;
    auto-select:                true;
    terminal:                   kitty;
}

@theme "themes/launcher.rasi"
